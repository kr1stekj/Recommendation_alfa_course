EMBEDDING_BACKEND=semantic
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_MAX_LENGTH=512
EMBEDDING_BATCH_SIZE=4
# CPU — переносимый вариант; при локальной пересборке на Apple Silicon можно --device mps.
EMBEDDING_DEVICE=cpu
# 1: использовать числовые векторы из репозитория; 0: явно пересчитать каталог.
USE_PRECOMPUTED_EMBEDDINGS=1
# Локальные демонстрационные значения, не пароль рабочей БД.
POSTGRES_PASSWORD=local-demo-only
# Для запуска Python на хосте; внутри Compose адрес сервера — postgres:5432.
# DATABASE_URL=postgresql://reco:local-demo-only@localhost:5433/reco
# TEST_DATABASE_URL=postgresql://reco:local-demo-only@localhost:5433/reco_test
# Необязательная облачная проверка. Реальный ключ задайте только в .env/окружении.
LLM_PROVIDER=openrouter
LLM_API_KEY=
LLM_MODEL=openai/gpt-4.1-mini
# Необязательный HTTP-прокси контейнера; реальные реквизиты задайте только в .env.
# RECO_PROXY_URL='http://USER:PASSWORD@HOST:PORT'
RECO_PROXY_URL=
# Для LLM_PROVIDER=compatible задайте собственный HTTPS base URL, без /chat/completions.
# LLM_BASE_URL=https://api.example.com/v1
# Прежний локальный вариант: LLM_PROVIDER=ollama, ключ не нужен.
# OLLAMA_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=your-local-model
